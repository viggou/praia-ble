// ble — Bluetooth Low Energy scanning for Praia.
//
// Linux:  raw HCI socket via HCI_CHANNEL_USER. Requires root or CAP_NET_RAW.
//         The high-level scan() temporarily powers off bluetoothd's claim on
//         the controller so legacy LE scan commands aren't rejected with
//         "Command Disallowed" by BT 5.x extended-mode controllers.
// macOS:  CoreBluetooth. The first time, macOS will prompt to grant the
//         terminal permission to access Bluetooth — accept it.
//
// Capability differences (call ble.capabilities() to inspect at runtime):
//
//   - On macOS, `address` is an anonymized per-app NSUUID, NOT the device's
//     real MAC. Apple does not expose MACs to userspace.
//   - On macOS, `data` (raw advertising bytes) is empty: CoreBluetooth gives
//     pre-parsed advertisement data only. The same parsed fields (`name`,
//     `services`, `manufacturerData`, etc.) are available either way.
//   - On macOS, `advType` is reported as "ind" or "nonconn-ind" based on the
//     connectable flag; "scan-rsp" never appears as a discrete event because
//     CoreBluetooth merges scan-response data into the same delegate call.
//   - On macOS, scan parameters (active vs passive, interval/window) are
//     not user-configurable; CoreBluetooth manages them internally.
//
// Usage:
//   use "ble"
//   let devs = ble.scan({duration: 5000, onAdv: lam{ d in
//       print(d.address, d.rssi, d?.name ?? "-")
//   }})

let _platform = sys.platform
let _isLinux  = _platform == "linux"
let _isDarwin = _platform == "darwin"

let _native = nil
if (_isLinux) {
    let arch = sys.exec(["uname", "-m"]).stdout.strip()
    _native = loadNative(path.dirname(sys.currentFile()) + "/plugins/ble-linux-" + arch + ".so")
} else {
    if (_isDarwin) {
        _native = loadNative(path.dirname(sys.currentFile()) + "/plugins/ble.dylib")
    } else {
        throw "ble: unsupported platform '" + _platform + "' (linux and darwin only)"
    }
}

// ── Adapter power management (Linux only) ──────────────────────────────────
// HCI_CHANNEL_USER requires the controller to be released by the kernel,
// i.e. powered off via the management interface. We toggle via bluetoothctl
// and remember whether we changed the state so disable() restores cleanly.
//
// We don't use `btmgmt` because on some systems (e.g. Fedora 10 with bluez
// 5.83) `btmgmt info` hangs indefinitely.
//
// On macOS this is a no-op — CoreBluetooth manages the radio itself.

func _powerState() {
    if (!_isLinux) { return nil }
    let r = sys.exec(["bluetoothctl", "--", "show"])
    if (r.exitCode != 0) { return nil }
    for (line in r.stdout.split("\n")) {
        let t = line.strip()
        if (t.startsWith("Powered:")) { return t.contains("yes") }
    }
    return nil
}

let _adapterTouched = {}

func _powerOffForExclusive(adapter) {
    if (!_isLinux) { return }
    let was = _powerState()
    if (was == nil) { return }
    if (was == true) {
        let r = sys.exec(["bluetoothctl", "--", "power", "off"])
        if (r.exitCode != 0) {
            throw "ble: failed to power off adapter: " + r.stderr.strip()
        }
        _adapterTouched[adapter] = true
    }
}

func _restorePower(adapter) {
    if (!_isLinux) { return }
    if (_adapterTouched.has(adapter)) {
        // bluetoothctl can briefly return "Busy" right after we close the
        // exclusive socket; retry a couple of times.
        for (i in 0..3) {
            let r = sys.exec(["bluetoothctl", "--", "power", "on"])
            if (r.exitCode == 0 && !r.stdout.contains("Busy")) { break }
            time.sleep(0.2)
        }
        _adapterTouched.delete(adapter)
    }
}

// ── Native passthroughs (work on both platforms) ───────────────────────────

func capabilities() {
    return _native.capabilities()
}

func open(adapterIndex, opts) {
    if (adapterIndex == nil) { adapterIndex = 0 }
    if (opts == nil) { opts = {} }
    return _native.open(adapterIndex, opts)
}

func startScan(handle, opts) {
    return opts == nil ? _native.startScan(handle) : _native.startScan(handle, opts)
}

func nextEvent(handle, timeoutMs) {
    return timeoutMs == nil ? _native.nextEvent(handle) : _native.nextEvent(handle, timeoutMs)
}

func stopScan(handle) {
    return _native.stopScan(handle)
}

func close(handle) {
    return _native.close(handle)
}

func parseAd(bytes) {
    return _native.parseAd(bytes)
}

// ── GATT (connect / discover / read / write / subscribe) ───────────────────
// GATT calls don't take an open() session handle — Linux uses BTPROTO_L2CAP
// directly (independent of any HCI socket), and macOS uses an internal
// process-wide central manager that caches CBPeripherals seen during scans.
//
// Linux note: if you have an exclusive ble.open() handle from low-level
// scanning, close it before calling connect — HCI_CHANNEL_USER claims the
// controller and blocks the kernel L2CAP stack. The high-level ble.scan()
// closes its handle automatically.

func connect(address, opts) {
    return opts == nil ? _native.connect(address)
                       : _native.connect(address, opts)
}

func disconnect(connHandle) {
    return _native.disconnect(connHandle)
}

func services(connHandle) {
    return _native.services(connHandle)
}

func characteristics(connHandle, startHandle, endHandle) {
    return _native.characteristics(connHandle, startHandle, endHandle)
}

func read(connHandle, valueHandle) {
    return _native.read(connHandle, valueHandle)
}

func write(connHandle, valueHandle, data, withResponse) {
    if (withResponse == nil) { withResponse = true }
    return _native.write(connHandle, valueHandle, data, withResponse)
}

func subscribe(connHandle, valueHandle, scanEndHandle) {
    return scanEndHandle == nil
        ? _native.subscribe(connHandle, valueHandle)
        : _native.subscribe(connHandle, valueHandle, scanEndHandle)
}

func unsubscribe(connHandle, cccdHandle) {
    return _native.unsubscribe(connHandle, cccdHandle)
}

func nextNotification(connHandle, timeoutMs) {
    return timeoutMs == nil
        ? _native.nextNotification(connHandle)
        : _native.nextNotification(connHandle, timeoutMs)
}

// ── High-level scan ────────────────────────────────────────────────────────
// Hops a single scan window for `duration` ms, collecting advertising reports.
// Returns an array of {address, addressType, rssi, advType, data, timestamp,
// (parsed AD fields merged in)}.
//
// opts:
//   adapter:    int (default 0, i.e. hci0). Linux only — ignored on macOS.
//   duration:   ms (default 5000)
//   active:     bool — Linux only; sends scan requests to elicit scan responses
//   intervalMs: scan interval (Linux only; default ~10ms)
//   windowMs:   scan window   (Linux only; default ~10ms)
//   filterDup:  bool — let the controller deduplicate. Default false.
//   dedup:      bool — Praia-side dedup by address. Default true.
//   onAdv:      callback invoked once per advertising report (raw event,
//               regardless of dedup)
func scan(opts) {
    let adapter   = opts?.adapter ?? 0
    let duration  = opts?.duration ?? 5000
    let dedup     = opts?.dedup ?? true
    let onAdv     = opts?.onAdv

    let scanOpts = {}
    if (opts?.active != nil)     { scanOpts.active = opts.active }
    if (opts?.intervalMs != nil) { scanOpts.intervalMs = opts.intervalMs }
    if (opts?.windowMs != nil)   { scanOpts.windowMs = opts.windowMs }
    if (opts?.filterDup != nil)  { scanOpts.filterDup = opts.filterDup }

    _powerOffForExclusive(adapter)
    defer _restorePower(adapter)

    let h = open(adapter, {exclusive: true})
    defer close(h)

    startScan(h, scanOpts)
    defer stopScan(h)

    let seen = {}
    let start = time.now()

    while (time.now() - start < duration) {
        let remaining = duration - (time.now() - start)
        let slice = remaining < 250 ? remaining : 250
        let evt = nextEvent(h, slice)
        if (!evt) { continue }

        // Linux returns raw AD bytes in `evt.data`; merge parsed fields. On
        // macOS `evt.data` is empty (CB doesn't expose raw bytes) and the
        // parsed fields are already populated by the native side, so
        // parseAd("") returns an empty map and the loop is a no-op.
        let ad = parseAd(evt.data)
        for (k in keys(ad)) { evt[k] = ad[k] }

        if (onAdv) { onAdv(evt) }

        if (dedup) {
            // Keep the most recent observation per address; merge fields
            // (e.g. scan-rsp on Linux often arrives separately and adds
            // `name` or services that the original ind didn't carry).
            if (seen.has(evt.address)) {
                let prev = seen[evt.address]
                for (k in keys(evt)) {
                    if (!prev.has(k) || k == "rssi" || k == "timestamp") {
                        prev[k] = evt[k]
                    }
                }
            } else {
                seen[evt.address] = evt
            }
        } else {
            seen[str(time.now()) + ":" + evt.address] = evt
        }
    }

    return values(seen)
}

export {
    capabilities,
    open, startScan, nextEvent, stopScan, close, parseAd,
    scan,
    connect, disconnect, services, characteristics,
    read, write, subscribe, unsubscribe, nextNotification
}
